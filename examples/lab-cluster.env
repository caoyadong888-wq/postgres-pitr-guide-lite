# Filled lab identity. Not a production recommendation.
# Host and mailbox use example.com. The address is inside 192.0.2.0/24
# (RFC 5737). This file is not sourced by the demo script.

LAB_NAME=lab-orders
LAB_HOST=db.example.com
LAB_IPV4=192.0.2.20
LAB_PORT=5432
LAB_USER=backup_lab
LAB_MAIL=dba@example.com
ARCHIVE_DIR=/var/backups/wal-lab
BASE_DIR=/var/backups/base-lab/2026-10-20
BASE_BACKUP_END_LSN=0/16000080
RECOVERY_TARGET_TIME=2026-10-20 09:15:00+00
RECOVERY_TARGET_TIMELINE=current
RECOVERY_TARGET_ACTION=pause
WAL_LEVEL=replica
ARCHIVE_MODE=on
ARCHIVE_TIMEOUT=60
